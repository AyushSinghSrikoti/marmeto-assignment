{
  "name": "marmeto-backend-take-home",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,worker,reconciler,courier \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:reconciler\" \"npm:dev:courier\"",
    "dev:api": "node --watch --conditions=development --experimental-strip-types src/server.ts",
    "dev:worker": "node --watch --conditions=development --experimental-strip-types src/worker.ts",
    "dev:reconciler": "node --watch --conditions=development --experimental-strip-types src/reconciler.ts",
    "dev:courier": "node --watch --conditions=development --experimental-strip-types src/mock-courier.ts",
    "build": "tsc",
    "start": "concurrently --kill-others-on-fail --names api,worker,reconciler,courier \"npm:start:api\" \"npm:start:worker\" \"npm:start:reconciler\" \"npm:start:courier\"",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "start:reconciler": "node dist/reconciler.js",
    "start:courier": "node dist/mock-courier.js",
    "jobs:failed": "node --conditions=development --experimental-strip-types src/job-admin.ts list",
    "job:replay": "node --conditions=development --experimental-strip-types src/job-admin.ts replay",
    "test": "node --test --test-concurrency=1 --conditions=development --experimental-strip-types tests/core.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "concurrently": "^10.0.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
